{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "dns",
  "main": "serve.tsx",
  "compatibility_date": "2026-10-15",
  "routes": [
    {
      "pattern": "dns.garn.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
